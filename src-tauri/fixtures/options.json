   {
    "name": "<home-manager/modules/home/stateVersion.nix>",
    "url": "https://github.com/nix-community/home-manager/blob/master/modules/home/stateVersion.nix"
   }
  ],
  "description": "It is occasionally necessary for Home Manager to change configuration defaults in a way that is incompatible with stateful data. This could, for example, include switching the default data format or location of a file.\n\nThe *state version* indicates which default settings are in effect and will therefore help avoid breaking program configurations. Switching to a higher state version typically requires performing some manual steps, such as data conversion or moving files.",
  "loc": [
   "home",
   "stateVersion"
  ],
  "readOnly": false,
  "type": "one of \"18.09\", \"19.03\", \"19.09\", \"20.03\", \"20.09\", \"21.05\", \"21.11\", \"22.05\", \"22.11\", \"23.05\", \"23.11\", \"24.05\", \"24.11\", \"25.05\""
